---
import Icon from './Icon.astro';
import { site, topicPages } from '../data/site';

// 導覽改為絕對路徑：三個主題專區是獨立頁面，首頁區塊則以 /#anchor 指向，
// 這樣在 /parking、/bike、/facilities 上都能正常運作。
const nav = [
  { label: '天氣', href: '/#weather' },
  { label: '亮點', href: '/#highlights' },
  { label: '園區地圖', href: '/#park-map' },
  ...topicPages.map((page) => ({ label: page.navLabel, href: page.path })),
  { label: '常見問題', href: '/#faq' },
];

const currentPath = Astro.url.pathname.replace(/\/index\.html$/, '/');
const isHome = currentPath === '/';
const isCurrent = (href: string) => href === currentPath;
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-white/[.10] bg-forest-950/[.85] text-white backdrop-blur-xl transition-shadow">
  <div class="container-page flex h-16 items-center justify-between md:h-[72px]">
    <a href={isHome ? '#top' : '/'} class="group flex items-center gap-3" aria-label={isHome ? '回到頁首' : '回到首頁總覽'}>
      <span class="grid size-10 place-items-center rounded-2xl bg-white/[.10] ring-1 ring-white/[.15] transition group-hover:bg-white/[.15]">
        <svg viewBox="0 0 48 48" class="size-7" aria-hidden="true">
          <path d="M24 39S8.5 30 8.5 18.8c0-6.2 7.3-9.4 11.8-3.7 1.5 1.9 2.6 4.1 3.7 6.3 1.1-2.2 2.2-4.4 3.7-6.3 4.5-5.7 11.8-2.5 11.8 3.7C39.5 30 24 39 24 39Z" fill="#f7f4ec"/>
          <path d="M24 33V21m0 4-5-4m5 7 6-4.5" fill="none" stroke="#b85f42" stroke-width="2.7" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="leading-tight">
        <strong class="block text-sm font-black tracking-wide sm:text-base">大溪河濱公園</strong>
        <span class="hidden text-[10px] font-semibold tracking-[.18em] text-white/[.55] sm:block">獨立旅遊指南</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="主要導覽">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-3 py-2 text-sm font-bold transition hover:bg-white/[.10] hover:text-white',
            isCurrent(item.href) ? 'bg-white/[.14] text-white' : 'text-white/[.75]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="hidden min-h-10 items-center gap-2 rounded-full bg-white px-4 text-sm font-black text-forest-950 transition hover:-translate-y-0.5 sm:inline-flex">
        <Icon name="pin" size={17} />
        開始導航
      </a>
      <button id="menu-toggle" type="button" class="grid size-10 place-items-center rounded-full bg-white/[.10] ring-1 ring-white/[.15] lg:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="開啟選單">
        <span data-menu-icon><Icon name="menu" /></span>
        <span data-close-icon class="hidden"><Icon name="close" /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="container-page hidden border-t border-white/[.10] py-3 lg:hidden" aria-label="行動版導覽">
    <div class="grid grid-cols-2 gap-1">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-xl px-3 py-3 text-sm font-bold hover:bg-white/[.10]',
            isCurrent(item.href) ? 'bg-white/[.10] text-white' : 'text-white/[.80]',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="col-span-2 mt-2 flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-3 text-sm font-black text-forest-950">
        <Icon name="pin" size={17} /> 開始導航
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const nav = document.querySelector<HTMLElement>('#mobile-nav');
  const menuIcon = toggle?.querySelector<HTMLElement>('[data-menu-icon]');
  const closeIcon = toggle?.querySelector<HTMLElement>('[data-close-icon]');

  const closeMenu = () => {
    nav?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    menuIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    if (open) closeMenu();
    else {
      nav?.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

  const header = document.querySelector<HTMLElement>('#site-header');
  const updateHeader = () => header?.classList.toggle('shadow-2xl', window.scrollY > 40);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>
