---
import Icon from './Icon.astro';

interface Props {
  items: readonly { question: string; answer: string }[];
}

const { items } = Astro.props;
---
<div class="divide-y divide-white/[.10] rounded-[2rem] border border-white/[.10] bg-white/[.05] px-5 sm:px-7">
  {items.map((item, index) => (
    <details class="group py-2" open={index === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 font-black text-white marker:hidden">
        <span>{item.question}</span>
        <span class="grid size-8 shrink-0 place-items-center rounded-full bg-white/[.08] text-white/[.60] transition group-open:rotate-180">
          <Icon name="chevron" size={17} />
        </span>
      </summary>
      <p class="max-w-2xl pb-6 pr-8 text-sm leading-8 text-white/[.58]">{item.answer}</p>
    </details>
  ))}
</div>
