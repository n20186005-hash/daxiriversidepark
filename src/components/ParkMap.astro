---
import Icon from './Icon.astro';
---
<div class="relative overflow-hidden rounded-[2rem] border border-forest-800/[.10] bg-[#e7eee2] shadow-[0_30px_70px_rgba(24,49,40,.12)]">
  <div class="absolute left-5 top-5 z-10 rounded-full bg-white/[.88] px-4 py-2 text-xs font-black text-forest-900 shadow-lg backdrop-blur">
    非比例園區示意圖
  </div>
  <svg viewBox="0 0 1000 650" role="img" aria-labelledby="park-map-title park-map-desc" class="min-h-[430px] w-full md:min-h-0">
    <title id="park-map-title">大溪河濱公園主要設施示意圖</title>
    <desc id="park-map-desc">標示主要入口、停車與 YouBike、廁所、海盜船遊戲場、自行車訓練場、大草坪、LOVE DAXI、步道與休憩亭。</desc>
    <defs>
      <linearGradient id="grass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#dbe8d5"/>
        <stop offset="1" stop-color="#c8dcc0"/>
      </linearGradient>
      <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#c9e4e6"/>
        <stop offset="1" stop-color="#9fcbd0"/>
      </linearGradient>
      <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#23463a" flood-opacity=".13"/>
      </filter>
    </defs>

    <rect width="1000" height="650" fill="url(#grass)"/>
    <path d="M0 525c140-35 240-15 350 20 150 48 260 53 380 18 105-31 183-35 270-10v97H0Z" fill="url(#water)"/>
    <path d="M0 508c155-38 249-11 355 23 150 48 255 48 373 15 106-30 188-31 272-7" fill="none" stroke="#f7f4ec" stroke-width="18" opacity=".95"/>
    <path d="M45 475c80-70 150-91 236-88 105 4 183 52 286 33 107-20 168-100 374-70" fill="none" stroke="#c3b69f" stroke-width="25" stroke-linecap="round" opacity=".72"/>
    <path d="M45 475c80-70 150-91 236-88 105 4 183 52 286 33 107-20 168-100 374-70" fill="none" stroke="#f6f0e5" stroke-width="12" stroke-linecap="round"/>

    <g fill="#739b7f" opacity=".88">
      <circle cx="90" cy="90" r="34"/><circle cx="155" cy="62" r="27"/><circle cx="210" cy="108" r="32"/>
      <circle cx="805" cy="90" r="31"/><circle cx="870" cy="68" r="37"/><circle cx="930" cy="116" r="29"/>
      <circle cx="690" cy="258" r="25"/><circle cx="742" cy="224" r="31"/><circle cx="780" cy="280" r="24"/>
    </g>

    <g filter="url(#shadow)">
      <rect x="62" y="225" width="220" height="112" rx="24" fill="#fffdf8"/>
      <rect x="80" y="243" width="82" height="76" rx="14" fill="#315c4c"/>
      <g fill="none" stroke="#fff" stroke-width="5">
        <circle cx="101" cy="284" r="13"/><circle cx="139" cy="284" r="13"/><path d="m101 284 16-28h16l16 28M116 256l17 28"/>
      </g>
      <text x="176" y="270" font-size="20" font-weight="800" fill="#183128">停車場</text>
      <text x="176" y="298" font-size="15" font-weight="650" fill="#53625a">YouBike・主要入口</text>
    </g>

    <g filter="url(#shadow)">
      <rect x="330" y="85" width="232" height="150" rx="28" fill="#fffdf8"/>
      <path d="M365 175h160l-20-65-46 24-35-39-29 42-30-15Z" fill="#b85f42"/>
      <path d="M374 176h143" stroke="#315c4c" stroke-width="9" stroke-linecap="round"/>
      <circle cx="399" cy="181" r="8" fill="#315c4c"/><circle cx="490" cy="181" r="8" fill="#315c4c"/>
      <text x="446" y="211" text-anchor="middle" font-size="19" font-weight="850" fill="#183128">海盜船遊戲場</text>
    </g>

    <g filter="url(#shadow)">
      <rect x="650" y="120" width="250" height="112" rx="26" fill="#fffdf8"/>
      <path d="M681 190c25-54 53-15 77-48 22-30 45 1 57 38 14-29 32-35 58-11" fill="none" stroke="#b85f42" stroke-width="10" stroke-linecap="round"/>
      <text x="775" y="211" text-anchor="middle" font-size="19" font-weight="850" fill="#183128">自行車訓練場</text>
    </g>

    <g filter="url(#shadow)">
      <rect x="300" y="282" width="290" height="104" rx="28" fill="#315c4c"/>
      <text x="445" y="323" text-anchor="middle" font-size="25" font-weight="900" fill="#fff">大草坪</text>
      <text x="445" y="352" text-anchor="middle" font-size="15" font-weight="650" fill="#dfeae2">野餐・奔跑・吹泡泡</text>
    </g>

    <g filter="url(#shadow)">
      <rect x="690" y="395" width="245" height="95" rx="25" fill="#fffdf8"/>
      <path d="M730 442c-27-20-50 13-13 37 37-24 14-57-13-37M781 442c-27-20-50 13-13 37 37-24 14-57-13-37" transform="scale(.6) translate(480 286)" fill="#b85f42"/>
      <text x="814" y="433" text-anchor="middle" font-size="19" font-weight="850" fill="#183128">LOVE DAXI</text>
      <text x="814" y="461" text-anchor="middle" font-size="14" font-weight="650" fill="#53625a">落羽松拍照點</text>
    </g>

    <g filter="url(#shadow)">
      <rect x="88" y="365" width="145" height="80" rx="22" fill="#fffdf8"/>
      <path d="M122 418v-33h32v33M113 418h50" fill="none" stroke="#315c4c" stroke-width="6" stroke-linecap="round"/>
      <text x="184" y="402" font-size="17" font-weight="850" fill="#183128">廁所</text>
      <text x="184" y="426" font-size="12" font-weight="650" fill="#53625a">無障礙</text>
    </g>

    <g filter="url(#shadow)">
      <rect x="380" y="468" width="205" height="75" rx="22" fill="#fffdf8"/>
      <path d="M415 512h36M433 512v-28M410 485h46l-8-12h-30Z" fill="none" stroke="#315c4c" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <text x="510" y="500" text-anchor="middle" font-size="17" font-weight="850" fill="#183128">休憩亭</text>
      <text x="510" y="523" text-anchor="middle" font-size="12" font-weight="650" fill="#53625a">遮陽座椅</text>
    </g>

    <g fill="#315c4c">
      <circle cx="91" cy="475" r="8"/><circle cx="272" cy="391" r="8"/><circle cx="594" cy="413" r="8"/><circle cx="944" cy="354" r="8"/>
    </g>
    <text x="86" y="574" fill="#315c4c" font-size="14" font-weight="750">水岸與步道方向</text>
  </svg>
  <div class="grid gap-3 border-t border-forest-800/[.10] bg-white/[.75] p-5 text-sm text-forest-900 backdrop-blur sm:grid-cols-3">
    <div class="flex gap-2"><Icon name="info" size={18} class="mt-0.5 shrink-0 text-cypress-500" /><span>示意圖用於快速理解區域關係，不代表精確比例與現場動線。</span></div>
    <div class="flex gap-2"><Icon name="route" size={18} class="mt-0.5 shrink-0 text-cypress-500" /><span>抵達後先確認廁所與停車位置，再安排遊具、單車與草地。</span></div>
    <div class="flex gap-2"><Icon name="shield" size={18} class="mt-0.5 shrink-0 text-cypress-500" /><span>水邊、攀爬設施與自行車場須由成人依現況看顧。</span></div>
  </div>
</div>
