---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<footer class="bg-forest-950 pb-24 pt-10 text-white md:pb-10">
  <div class="container-page flex flex-col gap-5 border-b border-white/[.12] pb-7 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-black">© {new Date().getFullYear()} {site.fullName} · 版權所有</p>
      <p class="mt-2 max-w-xl text-xs leading-6 text-white/[.65]">本網站是一個獨立的旅遊資訊項目。我們與任何政府機構或官方組織均無關聯。</p>
    </div>
    <nav aria-label="頁腳政策與來源" class="flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-white/[.75] sm:justify-end">
      <a href="/sources" class="hover:text-white">資料來源</a>
      <a href="/reviews" class="hover:text-white">評分與評論</a>
      <a href="/image-credits" class="hover:text-white">圖片版權</a>
      <a href="/privacy-policy" class="hover:text-white">隱私政策</a>
      <a href="/terms-of-service" class="hover:text-white">服務條款</a>
      <a href="/cookie-settings" class="hover:text-white">Cookie 設定</a>
    </nav>
  </div>
</footer>

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-forest-800/[.10] bg-white/[.92] p-2 shadow-[0_-12px_35px_rgba(24,49,40,.12)] backdrop-blur-xl md:hidden">
  <div class="mx-auto grid max-w-md grid-cols-3 gap-2">
    <a href="/#park-map" class="flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-xl text-[11px] font-black text-forest-800"><Icon name="map" size={19} />園區地圖</a>
    <a href="/parking" class="flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-xl text-[11px] font-black text-forest-800"><Icon name="parking" size={19} />停車交通</a>
    <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-xl bg-forest-800 text-[11px] font-black text-white"><Icon name="pin" size={19} />開始導航</a>
  </div>
</div>

