---
import GuideLayout from '../layouts/GuideLayout.astro';
import Icon from '../components/Icon.astro';
import { bikeGuide, bikeRentals, bikeExtraRoutes, bikeFaqs, site } from '../data/site';

export const prerender = true;

const toc = [
  { id: 'rent-methods', label: '三種取得車輛的方式' },
  { id: 'rent-compare', label: '車型與費用比較' },
  { id: 'bike-routes', label: '路線與時間' },
  { id: 'kids-track', label: '兒童自行車訓練場' },
  { id: 'bike-safety', label: '安全與裝備' },
];

const allRoutes = [...bikeGuide.routes, ...bikeExtraRoutes];
---

<GuideLayout topicId="bike" faqs={bikeFaqs} toc={toc}>
  <section id="rent-methods" class="section-pad bg-sand-50">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">租車方式</p>
        <h2 class="section-title">大溪河濱公園租腳踏車的三種方式</h2>
        <p class="section-lead">{bikeGuide.summary}</p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {bikeGuide.options.map((option) => (
          <article class="reveal soft-card flex flex-col rounded-[1.6rem] p-6">
            <span class="grid size-12 place-items-center rounded-2xl bg-forest-800 text-white"><Icon name={option.icon} size={23} /></span>
            <h3 class="mt-5 text-lg font-black text-forest-950">{option.title}</h3>
            <p class="mt-2 text-sm leading-7 text-slate-600">{option.detail}</p>
            {option.url && (
              <a href={option.url} target="_blank" rel="noopener noreferrer" class="btn-secondary mt-5 self-start">
                {option.linkLabel} <Icon name="external" size={15} />
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="rent-compare" class="section-pad bg-white">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">車型與費用</p>
        <h2 class="section-title">YouBike、老街租車店與自備車輛怎麼選</h2>
        <p class="section-lead">
          公共自行車方便、但車型固定；民營租車店車型齊全、但需先確認營業時間與價格。帶孩子同行時，車輛尺寸往往比租金高低更重要。
        </p>
      </div>

      <div class="reveal mt-10 overflow-hidden rounded-[2rem] border border-forest-800/[.12] bg-white shadow-[0_18px_48px_rgba(24,49,40,.06)]">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[760px] text-left">
            <caption class="sr-only">大溪河濱公園周邊租車方式比較</caption>
            <thead class="bg-moss-100 text-xs font-black tracking-wider text-forest-900">
              <tr>
                <th class="px-5 py-4">取得方式</th>
                <th class="px-5 py-4">可租車型</th>
                <th class="px-5 py-4">費用</th>
                <th class="px-5 py-4">適合誰</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-forest-800/[.08]">
              {bikeRentals.map((row) => (
                <tr class="text-sm">
                  <th class="px-5 py-5 align-top font-black text-forest-950">{row.way}</th>
                  <td class="px-5 py-5 align-top text-slate-700">{row.types}</td>
                  <td class="px-5 py-5 align-top font-black text-forest-800">{row.cost}</td>
                  <td class="px-5 py-5 align-top text-xs leading-6 text-slate-500">{row.fit}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="reveal mt-6 rounded-[1.6rem] border border-cypress-500/[.18] bg-[#fff8f4] p-5 sm:flex sm:items-start sm:gap-4">
        <Icon name="info" size={22} class="mt-0.5 shrink-0 text-cypress-600" />
        <p class="mt-2 text-sm leading-7 text-slate-600 sm:mt-0">
          <strong class="text-cypress-600">費用與車型請勿以本站為準：</strong>YouBike 費率依官方公告，民營租車店的車型、營業時間與價格各店不同。出發前請自行向店家或官方 App 確認，本站不代為報價。
        </p>
      </div>
    </div>
  </section>

  <section id="bike-routes" class="section-pad bg-sand-100">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">路線與時間</p>
        <h2 class="section-title">從園區出發的五條騎乘路線</h2>
        <p class="section-lead">
          距離與時間為一般狀況下的參考值，實際仍依路線、人潮、天候與路口停等調整。帶孩子同行請以平緩路段為主。
        </p>
      </div>

      <div class="reveal mt-10 overflow-hidden rounded-[2rem] border border-forest-800/[.12] bg-white shadow-[0_18px_48px_rgba(24,49,40,.06)]">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[760px] text-left">
            <caption class="sr-only">大溪河濱公園單車路線與時間參考</caption>
            <thead class="bg-moss-100 text-xs font-black tracking-wider text-forest-900">
              <tr>
                <th class="px-5 py-4">路線</th>
                <th class="px-5 py-4">距離</th>
                <th class="px-5 py-4">時間</th>
                <th class="px-5 py-4">說明</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-forest-800/[.08]">
              {allRoutes.map((route) => (
                <tr class="text-sm">
                  <th class="px-5 py-5 align-top font-black text-forest-950">{route.name}</th>
                  <td class="px-5 py-5 align-top text-slate-700">{route.distance}</td>
                  <td class="px-5 py-5 align-top font-black text-forest-800">{route.time}</td>
                  <td class="px-5 py-5 align-top text-xs leading-6 text-slate-500">{route.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <p class="reveal mt-5 text-sm leading-7 text-slate-600">
        其中「園區 → 大溪橋 → 大溪老街」是最多人安排的順遊路線，若想接著看老街停車與交通，請見
        <a href="/parking" class="font-black text-forest-800 underline underline-offset-4">停車與交通指南</a>。
      </p>
    </div>
  </section>

  <section id="kids-track" class="section-pad bg-white">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <p class="eyebrow">兒童自行車訓練場</p>
        <h2 class="section-title">孩子放電用：越野與平衡挑戰區</h2>
        <p class="mt-6 text-sm leading-8 text-slate-600">
          園區設有兒童自行車越野與平衡挑戰區，地面有起伏與轉彎，讓已能穩定騎乘的孩子練習控制、煞車與反應。它不是租車點，也沒有提供車輛或護具。
        </p>
        <ul class="mt-6 space-y-3">
          {[
            '請自備適合孩子身高與跨高的單車，不要用尺寸過大的車。',
            '頭盔務必扣緊，建議加戴護肘與護膝。',
            '雨後地面濕滑、煞停距離變長，建議改走草地或改期。',
            '幼童先在平坦處練習，再進入起伏路段。',
          ].map((tip) => (
            <li class="flex items-start gap-3 text-sm leading-7 text-slate-600">
              <Icon name="check" size={17} class="mt-1.5 shrink-0 text-forest-700" /> {tip}
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal grid gap-4 sm:grid-cols-2">
        {[
          { src: '/images/green-lawn.webp', alt: `大溪河濱公園草地與自行車活動空間（${site.city}）`, caption: '草地與練習空間' },
          { src: '/images/pirate-playground.webp', alt: '大溪河濱公園遊戲場', caption: '騎車後可續玩遊戲場' },
          { src: '/images/shaded-path.webp', alt: '大溪河濱公園林蔭步道', caption: '林蔭步道較涼爽' },
          { src: '/images/parking-youbike.webp', alt: '大溪河濱公園 YouBike 站與停車區', caption: 'YouBike 站與停車區' },
        ].map((photo) => (
          <figure class="overflow-hidden rounded-[1.4rem] border border-forest-800/[.10] bg-sand-50">
            <img src={photo.src} alt={photo.alt} width="640" height="480" loading="lazy" decoding="async" class="h-40 w-full object-cover sm:h-44" />
            <figcaption class="px-4 py-3 text-xs font-bold text-slate-500">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="bike-safety" class="section-pad bg-sand-50">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">安全與裝備</p>
        <h2 class="section-title">騎乘前請確認這四件事</h2>
        <p class="section-lead">園區與河岸自行車道都是開放空間，沒有專用封閉車道，安全要自己把關。</p>
      </div>

      <ul class="reveal mt-10 grid gap-3 sm:grid-cols-2">
        {bikeGuide.tips.map((tip) => (
          <li class="flex items-start gap-3 rounded-2xl border border-forest-800/[.10] bg-white px-5 py-4 text-sm leading-7 text-slate-600">
            <Icon name="check" size={17} class="mt-1.5 shrink-0 text-forest-700" /> {tip}
          </li>
        ))}
      </ul>

      <div class="reveal mt-8 flex flex-wrap gap-3">
        <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
          <Icon name="pin" size={18} /> 導航到園區
        </a>
        <a href="/facilities" class="btn-ghost">看園區設施與遊具 <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>
</GuideLayout>
