---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { nearbyAttractions } from '../../data/nearby-attractions';
import { site } from '../../data/site';

export const prerender = true;
export function getStaticPaths() {
  return nearbyAttractions.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}
const { place } = Astro.props;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.mapQuery)}`;
const imageSource = place.slug === 'wude-hall' ? '桃園市政府大溪木藝生態博物館' : place.slug === 'lee-teng-fang-house' ? 'Josh Ellis Photography' : '桃園市政府觀光旅遊局公開景點圖像';
const others = nearbyAttractions.filter((item) => item.slug !== place.slug).slice(0, 4);
const faqs = [
  { question: `${place.name}位於哪裡？`, answer: `地址或路線範圍：${place.address}。建議利用該景點專屬 Google 地圖連結確認入口與步行動線。` },
  { question: `${place.name}需要安排多久？`, answer: `${place.stay}是行程規劃建議，並非官方規定；依交通、同行者與現場情況調整。` },
  { question: `${place.name}需要門票嗎？何時開放？`, answer: `${place.admission}。${place.hours}。出發前仍應核對現場公告。` },
  { question: `${place.name}適合怎麼安排交通？`, answer: place.transit },
  { question: `前往${place.name}如何安排停車？`, answer: place.parking },
  place.faqFocus,
  { question: `前往${place.name}需要留意什麼？`, answer: place.caution },
];
---
<BaseLayout title={`${place.name}｜歷史、特色、交通與遊覽路線｜大溪周邊景點`} description={`${place.name}旅遊攻略：${place.subtitle}。整理歷史背景、建築或景觀特色、交通地圖、步行路線、拍照機位和常見問題。`} image={place.image} preloadImage={place.image} attraction={{name:place.name,type:place.type,district:place.district,mapUrl,officialUrl:place.official}} breadcrumbs={[{name:site.fullName,path:'/'},{name:'周邊景點',path:'/nearby'},{name:place.name,path:`/attractions/${place.slug}`}]} faqs={faqs}>
  <section class="relative overflow-hidden bg-forest-950 pt-24 text-white md:pt-32">
    <img src={place.image} alt={`${place.name}真實景觀照片`} width="1024" height="768" class="absolute inset-0 size-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(18,39,31,.95),rgba(18,39,31,.55)),linear-gradient(0deg,rgba(18,39,31,.9),transparent)]"></div>
    <div class="container-page relative z-10 pb-16 pt-8 md:pb-24">
      <nav class="mb-8 text-sm font-bold text-white/70"><a href="/" class="hover:text-white">大溪河濱公園</a> / <a href="/nearby" class="hover:text-white">周邊景點</a> / {place.name}</nav>
      <p class="text-xs font-black tracking-[.2em] text-[#e9b29d]">{place.english} · {place.type}</p>
      <h1 class="mt-4 max-w-4xl text-[clamp(2.3rem,6vw,4.5rem)] font-black leading-tight tracking-tight">{place.name}</h1>
      <p class="mt-4 max-w-3xl text-xl font-bold text-white/85">{place.subtitle}</p>
      <p class="mt-6 text-sm leading-7 text-white/75">{place.address} · {place.stay}</p>
      <div class="mt-5 flex flex-wrap gap-2 text-xs font-black"><span class="rounded-full bg-white/15 px-3 py-2">{place.admission}</span><span class="rounded-full bg-white/15 px-3 py-2">{place.hours}</span><a class="rounded-full bg-white/15 px-3 py-2 underline" href={mapUrl} target="_blank" rel="noopener noreferrer">Google 地圖評分與最新評論</a></div>
      <div class="mt-8 flex flex-wrap gap-3"><a href={mapUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center gap-2 rounded-full bg-white px-6 font-black text-forest-950"><Icon name="pin" size={18}/> 查看專屬 Google 地圖</a><a href="#route" class="inline-flex min-h-12 items-center gap-2 rounded-full border border-white/30 px-6 font-black">建議路線</a></div>
      <p class="mt-6 text-xs text-white/60">圖片：{imageSource} · <a class="underline" href={place.official} target="_blank" rel="noopener noreferrer">查看景點資料</a></p>
    </div>
  </section>

  <section id="about" class="section-pad bg-white"><div class="container-page grid gap-8 lg:grid-cols-[1.15fr_.85fr] lg:items-center"><div><p class="eyebrow">管理主體與歷史定位</p><h2 class="section-title">關於{place.name}</h2><p class="section-lead mt-5 max-w-4xl">{place.about}</p><p class="mt-5 leading-8 text-slate-700">{place.history}</p><p class="mt-5 text-sm text-slate-600">管理與景點資訊參考：<a class="font-bold text-forest-800 underline" href={place.official} target="_blank" rel="noopener noreferrer">桃園市政府官方旅遊資料</a>（2026-11-17 查核）。</p></div><div class="rounded-[2rem] bg-moss-100 p-8"><h3 class="text-xl font-black text-forest-950">管理與出行提醒</h3><p class="mt-4 leading-8 text-slate-700">{place.contact}。開放、維護與道路管制可能涉及不同單位，現場公告優先。</p><a href={place.official} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block font-black text-forest-800 underline">查看官方景點資訊</a></div></div></section>

  <section id="discover" class="section-pad bg-sand-50"><div class="container-page grid gap-10 lg:grid-cols-[1.15fr_.85fr]">
    <div><p class="eyebrow">探索景點</p><h2 class="section-title">走進{place.name}</h2><p class="section-lead mt-5">{place.intro}</p><p class="mt-5 leading-8 text-slate-700">{place.experience}</p><h3 class="mt-8 text-xl font-black text-forest-950">遊覽建議</h3><p class="mt-3 leading-8 text-slate-700">{place.visitTips}</p><p class="mt-3 leading-8 text-slate-700">{place.caution} 建議穿著好走的鞋、留意天氣與照明，並先使用專屬地圖檢查當日出入口。</p></div>
    <div class="soft-card rounded-[2rem] p-7"><h3 class="text-2xl font-black text-forest-950">景區特色</h3><ul class="mt-5 space-y-4">{place.highlights.map((point, i) => <li class="flex gap-3"><span class="grid size-9 shrink-0 place-items-center rounded-xl bg-forest-800 font-black text-white">{i+1}</span><span class="pt-1 font-bold leading-7 text-slate-700">{point}</span></li>)}</ul></div>
  </div></section>

  <section id="basics" class="section-pad bg-sand-100"><div class="container-page"><p class="eyebrow">出發前先看</p><h2 class="section-title">基本資料</h2><dl class="mt-8 grid gap-3 md:grid-cols-2">{[
    ['景點名稱',place.name],['英文名稱',place.english],['景點類型',place.type],['完整位置／地址',place.address],['建議停留',place.stay],['入場費用',place.admission],['開放時間',place.hours],['聯絡／管理查詢',place.contact],
  ].map(([term,value]) => <div class="rounded-2xl bg-white p-5"><dt class="text-xs font-black tracking-widest text-slate-500">{term}</dt><dd class="mt-2 text-base font-bold leading-7 text-forest-950">{value}</dd></div>)}</dl></div></section>

  <section id="hours-tickets" class="section-pad bg-white"><div class="container-page"><p class="eyebrow">開放與費用</p><h2 class="section-title">開放時間與門票價格</h2><div class="mt-8 grid gap-5 md:grid-cols-2"><article class="soft-card rounded-3xl p-7"><h3 class="text-xl font-black text-forest-950">開放時間</h3><p class="mt-4 leading-8 text-slate-700">{place.hours}</p><p class="mt-4 text-sm leading-7 text-slate-500">戶外場域仍可能因天候、維修或大型活動暫時調整，出發前請查看官方及現場公告。</p></article><article class="soft-card rounded-3xl p-7"><h3 class="text-xl font-black text-forest-950">門票與其他費用</h3><p class="mt-4 leading-8 text-slate-700">{place.admission}</p><p class="mt-4 text-sm leading-7 text-slate-500">交通、停車、單車租借、店家消費或特別活動不包含在一般公共場域通行費用內。</p></article></div></div></section>

  <section id="transport" class="section-pad bg-sand-100"><div class="container-page"><p class="eyebrow">交通方式</p><h2 class="section-title">怎麼前往{place.name}？</h2><div class="mt-8 grid gap-6 lg:grid-cols-3"><article class="soft-card rounded-[2rem] p-7"><h3 class="text-xl font-black">自行開車與停車</h3><p class="mt-4 leading-8 text-slate-700">{place.parking}</p></article><article class="soft-card rounded-[2rem] p-7"><h3 class="text-xl font-black">大眾運輸與步行</h3><p class="mt-4 leading-8 text-slate-700">{place.transit}</p></article><article class="soft-card rounded-[2rem] p-7"><h3 class="text-xl font-black">交通查詢</h3><p class="mt-4 leading-8 text-slate-700">公車班次、停靠站與道路管制可能異動；請以桃園公車動態及現場指引為準。</p><div class="mt-6 flex flex-wrap gap-3"><a class="btn-primary" href="https://ebus.tycg.gov.tw/ebus/" target="_blank" rel="noopener noreferrer">桃園公車動態</a></div></article></div></div></section>

  <section id="map" class="section-pad bg-white"><div class="container-page grid gap-8 lg:grid-cols-2"><div><p class="eyebrow">路線地圖</p><h2 class="section-title">{place.name}專屬地圖</h2><p class="section-lead mt-4">地址／路線起點：{place.address}。使用景點名稱與地點資訊搜尋，避免誤導至主公園。若出現多個入口，請對照官方景點資訊選擇實際通道。</p><div class="mt-6 flex flex-wrap gap-3"><a class="btn-primary" href={mapUrl} target="_blank" rel="noopener noreferrer">開啟 Google Maps</a><a class="btn-primary" href={place.official} target="_blank" rel="noopener noreferrer">查看官方資料</a></div></div><div class="rounded-[2rem] bg-moss-100 p-7"><h3 class="text-xl font-black text-forest-950">抵達前核對</h3><ol class="mt-5 list-decimal space-y-4 pl-6 leading-8 text-slate-700"><li>確認目的地是「{place.name}」。</li><li>核對入口、道路通行及停車位置。</li><li>留意回程車班、天候和開放時間。</li></ol></div></div></section>

  <section id="culture" class="section-pad bg-sand-50"><div class="container-page"><p class="eyebrow">發現魅力</p><h2 class="section-title">歷史、建築與文化觀察</h2><div class="mt-8 grid gap-5 md:grid-cols-2"><article class="soft-card rounded-3xl p-7"><h3 class="text-xl font-black text-forest-950">歷史背景</h3><p class="mt-4 leading-8 text-slate-700">{place.history}</p></article><article class="soft-card rounded-3xl p-7"><h3 class="text-xl font-black text-forest-950">建築與地景特色</h3><p class="mt-4 leading-8 text-slate-700">{place.structure}</p></article><article class="soft-card rounded-3xl p-7"><h3 class="text-xl font-black text-forest-950">文化與地方生活</h3><p class="mt-4 leading-8 text-slate-700">{place.culture}</p></article><article class="soft-card rounded-3xl p-7"><h3 class="text-xl font-black text-forest-950">核心遊覽體驗</h3><p class="mt-4 leading-8 text-slate-700">{place.experience}</p></article></div></div></section>

  <section id="route" class="section-pad bg-white"><div class="container-page"><p class="eyebrow">按順序慢遊</p><h2 class="section-title">建議遊覽路線</h2><ol class="mt-8 grid gap-4 md:grid-cols-3">{place.route.map((step,i)=><li class="soft-card rounded-3xl p-6"><span class="grid size-10 place-items-center rounded-full bg-forest-800 font-black text-white">{i+1}</span><p class="mt-5 leading-8 text-slate-700">{step}</p></li>)}</ol></div></section>

  <section id="photos" class="section-pad bg-sand-100"><div class="container-page grid gap-8 lg:grid-cols-2"><div><p class="eyebrow">實景與拍攝機位</p><h2 class="section-title">看見{place.name}的細節</h2><img src={place.image} alt={`${place.name}專屬景點實景`} width="1024" height="768" loading="lazy" class="mt-7 w-full rounded-[2rem] object-cover shadow-lg" /><p class="mt-3 text-xs text-slate-500">實景圖來源：{imageSource}。圖片權利歸原權利人。</p></div><div><h3 class="text-2xl font-black text-forest-950">拍照建議</h3><ul class="mt-5 space-y-4">{place.photo.map((tip,i)=><li class="soft-card rounded-2xl p-5 leading-7 text-slate-700"><strong class="mr-2 text-forest-800">{i+1}.</strong>{tip}</li>)}</ul><h3 class="mt-8 text-xl font-black">遊覽須知</h3><p class="mt-3 leading-8 text-slate-700">{place.caution} 尊重當地居民、景觀及公共設施，並自備飲水、遮陽或雨具。</p><h3 class="mt-8 text-xl font-black">住宿與用餐</h3><p class="mt-3 leading-8 text-slate-700">{place.lodging}</p><p class="mt-3 leading-8 text-slate-700">若需要用餐，可按當天行程選擇大溪老街或龍潭聚落的合法營業店家，先核對實際營業時段。</p></div></div></section>

  <section id="reviews" class="section-pad bg-white"><div class="container-page grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center"><div><p class="eyebrow">遊客評價</p><h2 class="section-title">參考 Google 地圖最新評論</h2><p class="section-lead mt-4">各景點的評分與評論數持續變動，建議在出發前透過景點專屬 Google 地圖頁查看最新評價、評論筆數與旅客照片，特別留意近期的施工、停車及通行回報。</p></div><a class="btn-primary" href={mapUrl} target="_blank" rel="noopener noreferrer">查看{place.name}評價</a></div></section>

  <section id="faq" class="section-pad bg-forest-950 text-white"><div class="container-page"><p class="eyebrow text-[#e9b29d]!">常見問題</p><h2 class="section-title text-white!">{place.name} FAQ</h2><div class="mt-8 grid gap-4 md:grid-cols-2">{faqs.map((item)=><article class="rounded-2xl bg-white/10 p-6"><h3 class="font-black">{item.question}</h3><p class="mt-3 text-sm leading-7 text-white/75">{item.answer}</p></article>)}</div></div></section>

  <section class="section-pad bg-white"><div class="container-page"><p class="eyebrow">繼續探索</p><h2 class="section-title">更多大溪周邊景點</h2><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{others.map(item=><a href={`/attractions/${item.slug}`} class="soft-card group overflow-hidden rounded-2xl"><img src={item.image} alt={`${item.name}實景`} loading="lazy" width="1024" height="768" class="aspect-[4/3] w-full object-cover" /><div class="p-4"><h3 class="font-black text-forest-950">{item.name}</h3><p class="mt-2 text-xs leading-6 text-slate-600">{item.subtitle}</p><span class="mt-3 block text-sm font-black text-forest-800">閱讀景點專頁 →</span></div></a>)}</div><div class="mt-7 flex flex-wrap gap-4"><a href="/nearby" class="btn-primary">全部周邊景點</a><a href="/" class="btn-primary">返回大溪河濱公園首頁</a></div></div></section>
</BaseLayout>
