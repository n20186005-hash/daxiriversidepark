---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ParkMap from '../components/ParkMap.astro';
import RoutePlanner from '../components/RoutePlanner.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import {
  ageGuide,
  facilities,
  faqs,
  highlights,
  nearbyTrips,
  quickFacts,
  site,
} from '../data/site';

const suitable = [
  '帶幼兒或小學生到戶外放電',
  '想找免費、開闊的野餐草地',
  '自備兒童單車與安全護具',
  '秋冬想拍落羽松與 LOVE DAXI',
  '安排大溪老街半日順遊',
];

const notIdeal = [
  '雨天或大雨剛過、地面濕滑',
  '夏季正午且沒有遮陽準備',
  '期待大量餐廳、商店或室內設施',
  '只想欣賞無遮擋的壯闊河景',
];
---
<BaseLayout>
  <section id="top" class="relative min-h-[760px] overflow-hidden bg-forest-950 pt-16 text-white md:min-h-[820px] md:pt-[72px]">
    <div class="absolute inset-0">
      <img
        src="/images/hero-playground.jpg"
        alt="大溪河濱公園海盜船遊戲場與綠地"
        width="1200"
        height="675"
        fetchpriority="high"
        class="size-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(18,39,31,.92)_0%,rgba(24,49,40,.70)_43%,rgba(24,49,40,.22)_75%,rgba(24,49,40,.15)_100%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(24,49,40,.96)_0%,transparent_42%)]"></div>
    </div>

    <div class="container-page relative z-10 flex min-h-[690px] items-center py-16 md:min-h-[748px]">
      <div class="max-w-[760px]">
        <div class="mb-6 flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-white/[.20] bg-white/[.10] px-3 py-1.5 text-xs font-black tracking-wide backdrop-blur">桃園・大溪</span>
          <span class="rounded-full border border-white/[.20] bg-white/[.10] px-3 py-1.5 text-xs font-black tracking-wide backdrop-blur">免費親子景點</span>
          <span class="rounded-full border border-white/[.20] bg-white/[.10] px-3 py-1.5 text-xs font-black tracking-wide backdrop-blur">獨立旅遊指南</span>
        </div>
        <h1 class="text-[clamp(3.25rem,9vw,7.2rem)] font-black leading-[.92] tracking-[-.065em] text-white">
          大溪河濱<br /><span class="text-[#e9b29d]">公園</span>
        </h1>
        <p class="mt-7 max-w-2xl text-base font-medium leading-8 text-white/[.80] sm:text-lg md:text-xl md:leading-9">
          一次掌握海盜船遊具、兒童單車場、落羽松、野餐草地、停車入口與大溪老街順遊方式。
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-14 items-center justify-center gap-2 rounded-full bg-white px-6 text-base font-black text-forest-950 shadow-2xl transition hover:-translate-y-1">
            <Icon name="pin" size={20} /> 開始 Google Maps 導航
          </a>
          <a href="#plan" class="inline-flex min-h-14 items-center justify-center gap-2 rounded-full border border-white/[.25] bg-white/[.10] px-6 text-base font-black text-white backdrop-blur transition hover:bg-white/[.18]">
            依停留時間規劃 <Icon name="arrow" size={19} />
          </a>
        </div>
        <p class="mt-5 flex items-start gap-2 text-sm leading-6 text-white/[.58]">
          <Icon name="pin" size={16} class="mt-1 shrink-0" />
          <span>{site.address}・入口位於巷道內，建議直接使用座標導航。</span>
        </p>
      </div>
    </div>

    <div class="container-page relative z-20 pb-8">
      <dl class="glass-card grid gap-px overflow-hidden rounded-[1.6rem] bg-forest-800/[.14] sm:grid-cols-2 lg:grid-cols-5">
          {quickFacts.map((fact, index) => (
            <div class:list={['flex min-w-0 items-center gap-3 bg-white/[.88] p-4 text-forest-950 sm:p-5', index === quickFacts.length - 1 && 'sm:col-span-2 lg:col-span-1']}>
              <span class="grid size-10 shrink-0 place-items-center rounded-2xl bg-moss-100 text-forest-800">
                <Icon name={fact.icon} size={19} />
              </span>
              <span class="min-w-0">
                <dt class="text-[10px] font-black tracking-[.14em] text-slate-500">{fact.label}</dt>
                <dd class="mt-0.5 text-sm font-black leading-5 sm:text-[15px]">{fact.value}</dd>
              </span>
            </div>
          ))}
      </dl>
    </div>
  </section>

  <section class="section-pad pb-16">
    <div class="container-page">
      <div class="reveal grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
        <div>
          <p class="eyebrow">行前判斷</p>
          <h2 class="section-title">先判斷，這裡是不是你要找的公園</h2>
        </div>
        <p class="section-lead lg:ml-auto">
          大溪河濱公園的強項不是商業設施，而是開闊、免費與多樣的戶外活動。帶對裝備、選對時段，親子體驗會好很多。
        </p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-2">
        <article class="reveal overflow-hidden rounded-[2rem] bg-forest-800 p-6 text-white shadow-[0_25px_70px_rgba(49,92,76,.22)] sm:p-8">
          <div class="flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-2xl bg-white/[.12]"><Icon name="check" size={22} /></span>
            <h3 class="text-2xl font-black">很適合你，如果……</h3>
          </div>
          <ul class="mt-7 grid gap-3">
            {suitable.map((item) => (
              <li class="flex items-start gap-3 rounded-2xl bg-white/[.08] px-4 py-3.5 text-sm font-bold leading-6 text-white/[.88]">
                <Icon name="check" size={17} class="mt-1 shrink-0 text-[#f0baa5]" /> {item}
              </li>
            ))}
          </ul>
        </article>

        <article class="reveal soft-card overflow-hidden rounded-[2rem] p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-2xl bg-sand-200 text-cypress-600"><Icon name="x" size={22} /></span>
            <h3 class="text-2xl font-black text-forest-950">可能不太適合，如果……</h3>
          </div>
          <ul class="mt-7 grid gap-3">
            {notIdeal.map((item) => (
              <li class="flex items-start gap-3 rounded-2xl bg-sand-100 px-4 py-3.5 text-sm font-bold leading-6 text-slate-600">
                <Icon name="x" size={17} class="mt-1 shrink-0 text-cypress-500" /> {item}
              </li>
            ))}
          </ul>
          <div class="mt-6 rounded-2xl border border-cypress-500/[.15] bg-[#fff8f4] p-4 text-sm leading-6 text-slate-600">
            <strong class="text-cypress-600">最佳時段：</strong>夏季上午 8–11 點或下午 4 點後；秋冬可安排下午散步與拍照。
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="highlights" class="section-pad bg-sand-100">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">景點亮點</p>
        <h2 class="section-title">四個理由，把它放進大溪行程</h2>
        <p class="section-lead">從體能型遊具到季節景觀，每個區域對應不同玩法；不用把所有時間都花在同一處。</p>
      </div>

      <div class="mt-14 grid gap-7">
        {highlights.map((item, index) => (
          <article class="reveal soft-card grid overflow-hidden rounded-[2rem] lg:grid-cols-2">
            <div class:list={['relative min-h-[310px] overflow-hidden lg:min-h-[440px]', index % 2 === 1 && 'lg:order-2']}>
              <img src={item.image} alt={item.alt} width="1280" height="960" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover transition duration-700 hover:scale-[1.03]" />
              <span class="absolute left-5 top-5 rounded-full bg-white/[.88] px-4 py-2 text-xs font-black text-forest-900 shadow-lg backdrop-blur">{item.tag}</span>
            </div>
            <div class="flex flex-col justify-center p-7 sm:p-10 lg:p-14">
              <p class="text-xs font-black tracking-[.18em] text-cypress-600">{item.eyebrow}</p>
              <h3 class="mt-3 text-3xl font-black tracking-tight text-forest-950 sm:text-4xl">{item.title}</h3>
              <p class="mt-5 text-base leading-8 text-slate-600">{item.description}</p>
              <div class="mt-7 flex items-center gap-2 text-sm font-black text-forest-800">
                查看園區位置 <Icon name="arrow" size={17} />
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="park-map" class="section-pad overflow-hidden">
    <div class="container-page">
      <div class="reveal grid gap-9 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
        <div>
          <p class="eyebrow">園區導覽</p>
          <h2 class="section-title">先看懂園區，再決定孩子從哪裡開始玩</h2>
        </div>
        <p class="section-lead lg:ml-auto">這張原創示意圖集中標出最重要的區域。它不是測繪地圖，實際入口、設施開放與施工動線仍以現場為準。</p>
      </div>
      <div class="reveal mt-12"><ParkMap /></div>
    </div>
  </section>

  <section id="family" class="section-pad bg-forest-950 text-white">
    <div class="container-page">
      <div class="reveal grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
        <div>
          <p class="eyebrow text-[#e9b29d]!">親子指南</p>
          <h2 class="section-title text-white!">不同年齡，不必玩同一套</h2>
        </div>
        <p class="section-lead text-white/[.65]! lg:ml-auto">官方將多項共融遊具標示為 2–12 歲，但適齡不代表每一項都適合每個孩子。以身高、握力、平衡與當日場地狀況判斷更實際。</p>
      </div>

      <div class="reveal mt-12 overflow-hidden rounded-[2rem] border border-white/[.10] bg-white/[.06]">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[760px] text-left">
            <caption class="sr-only">大溪河濱公園不同年齡兒童活動建議</caption>
            <thead class="bg-white/[.08] text-xs font-black tracking-wider text-white/[.55]">
              <tr>
                <th class="px-5 py-4">活動</th>
                <th class="px-5 py-4">2–4 歲</th>
                <th class="px-5 py-4">5–7 歲</th>
                <th class="px-5 py-4">8–12 歲</th>
                <th class="px-5 py-4">提醒</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[.08]">
              {ageGuide.map((row) => (
                <tr class="text-sm">
                  <th class="px-5 py-5 font-black text-white">{row.activity}</th>
                  <td class="px-5 py-5 text-white/[.72]">{row.toddler}</td>
                  <td class="px-5 py-5 text-white/[.72]">{row.child}</td>
                  <td class="px-5 py-5 text-white/[.72]">{row.older}</td>
                  <td class="max-w-xs px-5 py-5 leading-6 text-white/[.55]">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="reveal mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['sun', '防曬與飲水', '開闊草坪曝曬明顯，夏季需特別準備。'],
          ['bike', '頭盔與護具', '使用自行車訓練場時不可省略。'],
          ['shield', '水邊看顧', '園內水域不是一般開放戲水池。'],
          ['leaf', '垃圾帶走', '野餐後維持草地與步道整潔。'],
        ].map(([icon, title, text]) => (
          <div class="rounded-[1.5rem] border border-white/[.10] bg-white/[.06] p-5">
            <Icon name={icon} size={23} class="text-[#e9b29d]" />
            <h3 class="mt-4 font-black">{title}</h3>
            <p class="mt-2 text-sm leading-6 text-white/[.55]">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="plan" class="section-pad bg-sand-100">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">依時間規劃</p>
        <h2 class="section-title">你有多少時間？直接套用這三條路線</h2>
        <p class="section-lead">先選停留時間，再依孩子體力與天候刪減；不用為了「走完」而犧牲休息。</p>
      </div>
      <div class="reveal mt-12"><RoutePlanner /></div>
    </div>
  </section>

  <section class="section-pad overflow-hidden">
    <div class="container-page grid gap-10 lg:grid-cols-[1.08fr_.92fr] lg:items-center">
      <div class="reveal relative min-h-[520px] overflow-hidden rounded-[2.2rem]">
        <img src="/images/love-daxi.webp" alt="大溪河濱公園 LOVE DAXI 實景" width="1280" height="960" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-forest-950/[.85] via-transparent to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-6 text-white sm:p-9">
          <span class="rounded-full bg-white/[.14] px-3 py-1.5 text-xs font-black backdrop-blur">季節景觀</span>
          <h2 class="mt-4 text-3xl font-black sm:text-4xl">落羽松不是每天都紅</h2>
          <p class="mt-3 max-w-xl text-sm leading-7 text-white/[.72]">固定月份只能當作參考。到訪前查看最近一至兩週的實景照片，比追逐網路上的舊日期更可靠。</p>
        </div>
      </div>

      <div class="reveal">
        <p class="eyebrow">落羽松季節</p>
        <h2 class="section-title">抓住轉色窗口，而不是只記一個日期</h2>
        <div class="mt-8 space-y-4">
          {[
            ['11 月', '多數年份仍以綠色為主，可能開始局部轉黃。'],
            ['12 月', '較常進入金黃、橘色變化期，仍須看當年天候。'],
            ['1 月', '可能呈橘紅、褐紅或開始落葉，狀況變化快。'],
          ].map(([month, text], index) => (
            <div class="grid grid-cols-[74px_1fr] gap-4 rounded-2xl border border-forest-800/[.10] bg-white p-4 shadow-sm">
              <span class:list={['grid min-h-16 place-items-center rounded-xl text-sm font-black', index === 1 ? 'bg-cypress-500 text-white' : 'bg-moss-100 text-forest-800']}>{month}</span>
              <p class="self-center text-sm leading-6 text-slate-600">{text}</p>
            </div>
          ))}
        </div>
        <div class="mt-6 rounded-2xl border border-cypress-500/[.20] bg-[#fff8f4] p-5">
          <p class="flex gap-2 text-sm font-black text-cypress-600"><Icon name="camera" size={18} />拍照建議</p>
          <p class="mt-2 text-sm leading-7 text-slate-600">晴天下午光線較柔和；人物穿米白、深綠或暖棕色，在草地與紅色裝置前較容易形成層次。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad bg-moss-100/[.65]">
    <div class="container-page">
      <div class="reveal grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-end">
        <div>
          <p class="eyebrow">園區設施</p>
          <h2 class="section-title">有基本設施，但要把它當作戶外公園準備</h2>
        </div>
        <p class="section-lead lg:ml-auto">園內有停車、廁所、遮陽、YouBike 與體健設施；餐飲、補水與兒童備用品則建議在抵達前準備。</p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {facilities.map((item) => (
          <article class="reveal soft-card rounded-[1.6rem] p-6">
            <span class="grid size-12 place-items-center rounded-2xl bg-forest-800 text-white"><Icon name={item.icon} size={23} /></span>
            <h3 class="mt-5 text-lg font-black text-forest-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-7 text-slate-600">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="transport" class="section-pad">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">交通方式</p>
        <h2 class="section-title">交通與停車：最後一段巷道最容易錯過</h2>
        <p class="section-lead">導航請直接使用景點座標，不要只在大鶯路主線尋找醒目的大型景區入口。</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-[1.08fr_.92fr]">
        <article class="reveal overflow-hidden rounded-[2rem] bg-forest-950 text-white">
          <div class="relative min-h-[300px]">
            <img src="/images/parking-youbike.webp" alt="大溪河濱公園停車區與 YouBike 實景" width="1280" height="960" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-forest-950 via-forest-950/[.20] to-transparent"></div>
            <span class="absolute left-5 top-5 rounded-full bg-white/[.88] px-4 py-2 text-xs font-black text-forest-950">實景照片</span>
          </div>
          <div class="p-6 sm:p-8">
            <div class="flex items-center gap-3">
              <span class="grid size-11 place-items-center rounded-2xl bg-white/[.10]"><Icon name="parking" size={22} /></span>
              <h3 class="text-2xl font-black">自駕與停車</h3>
            </div>
            <ul class="mt-6 space-y-4 text-sm leading-7 text-white/[.68]">
              <li class="flex gap-3"><Icon name="check" size={17} class="mt-1.5 shrink-0 text-[#e9b29d]" />導航地址：{site.address}</li>
              <li class="flex gap-3"><Icon name="check" size={17} class="mt-1.5 shrink-0 text-[#e9b29d]" />入口位於巷道內，最後一段請放慢車速並留意現場指示。</li>
              <li class="flex gap-3"><Icon name="check" size={17} class="mt-1.5 shrink-0 text-[#e9b29d]" />晴朗假日、活動日與落羽松季可能較滿，建議上午抵達。</li>
              <li class="flex gap-3"><Icon name="check" size={17} class="mt-1.5 shrink-0 text-[#e9b29d]" />僅停放於合法車格，現場收費與管制以最新告示為準。</li>
            </ul>
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex min-h-12 items-center gap-2 rounded-full bg-white px-5 text-sm font-black text-forest-950">
              <Icon name="pin" size={18} /> 導航至大溪河濱公園
            </a>
          </div>
        </article>

        <div class="grid gap-6">
          <article class="reveal soft-card rounded-[2rem] p-6 sm:p-8">
            <span class="grid size-11 place-items-center rounded-2xl bg-moss-100 text-forest-800"><Icon name="bike" size={22} /></span>
            <h3 class="mt-5 text-2xl font-black text-forest-950">YouBike 與自行車</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">園區設有 YouBike 站，也可銜接河岸自行車相關路線。公共自行車的車輛與空柱會即時變動，出發前請查官方 App。</p>
            <a href="https://map.youbike.com.tw/search?location=大溪河濱公園" target="_blank" rel="noopener noreferrer" class="btn-secondary mt-5">查詢 YouBike <Icon name="external" size={15} /></a>
          </article>

          <article class="reveal soft-card rounded-[2rem] p-6 sm:p-8">
            <span class="grid size-11 place-items-center rounded-2xl bg-moss-100 text-forest-800"><Icon name="route" size={22} /></span>
            <h3 class="mt-5 text-2xl font-black text-forest-950">大眾運輸</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">可查詢往大溪方向的桃園公車與鄰近站牌，再步行進入園區。班次與站點可能調整，不在本站硬編固定時刻。</p>
            <div class="mt-5 flex flex-wrap gap-2">
              <a href="https://ebus.tycg.gov.tw/ebus/" target="_blank" rel="noopener noreferrer" class="btn-secondary">桃園公車動態 <Icon name="external" size={15} /></a>
              <a href={site.tourismUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">官方交通資訊 <Icon name="external" size={15} /></a>
            </div>
          </article>
        </div>
      </div>

      <div class="reveal mt-6 overflow-hidden rounded-[2rem] border border-forest-800/[.12] bg-white shadow-[0_18px_48px_rgba(24,49,40,.06)]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3619.138408483746!2d121.28106307537193!3d24.89326007790791!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x34681817b55e18cd%3A0x337e23894ae95017!2z5aSn5rqq5rKz5ruo5YWs5Zut!5e0!3m2!1szh-CN!2stw!4v1785298572973!5m2!1szh-CN!2stw"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="大溪河濱公園 Google 地圖"
          class="block h-[360px] w-full sm:h-[450px]"
        ></iframe>
      </div>

      <div class="reveal mt-6 rounded-[1.6rem] border border-cypress-500/[.18] bg-[#fff8f4] p-5 sm:flex sm:items-center sm:justify-between sm:gap-6">
        <div class="flex gap-3">
          <Icon name="info" size={22} class="mt-0.5 shrink-0 text-cypress-600" />
          <p class="text-sm leading-7 text-slate-600"><strong class="text-cypress-600">河濱安全提醒：</strong>豪雨、颱風、河川水位異常或主管機關封閉時不要進入；24 小時開放不等於所有時段、所有天候都適合遊玩。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad bg-sand-100">
    <div class="container-page">
      <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="eyebrow">實景照片</p>
          <h2 class="section-title">先看實景，再決定要帶什麼</h2>
        </div>
        <p class="max-w-md text-sm leading-7 text-slate-600">照片來自桃園市政府工務局「樂桃園 P@rk Go」，已轉為站內圖片並於頁尾標示來源。</p>
      </div>
      <div class="reveal mt-12"><PhotoGallery /></div>
    </div>
  </section>

  <section id="nearby" class="section-pad">
    <div class="container-page">
      <div class="reveal grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
        <div>
          <p class="eyebrow">周邊順遊</p>
          <h2 class="section-title">不要只玩一座公園，把它接進大溪半日遊</h2>
        </div>
        <p class="section-lead lg:ml-auto">河濱公園最適合當作親子行程的第一站：先消耗體力，再去老街用餐與散步。</p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {nearbyTrips.map((trip, index) => (
          <article class:list={['reveal rounded-[2rem] p-6 sm:p-7', index === 0 ? 'bg-forest-800 text-white shadow-[0_25px_60px_rgba(49,92,76,.2)]' : 'soft-card']}>
            <span class:list={['inline-flex rounded-full px-3 py-1.5 text-xs font-black', index === 0 ? 'bg-white/[.12] text-white/[.75]' : 'bg-moss-100 text-forest-800']}>{trip.meta}</span>
            <h3 class:list={['mt-5 text-2xl font-black', index === 0 ? 'text-white' : 'text-forest-950']}>{trip.title}</h3>
            <ol class="mt-6 space-y-0">
              {trip.stops.map((stop, stopIndex) => (
                <li class="relative flex gap-3 pb-5 last:pb-0">
                  {stopIndex < trip.stops.length - 1 && <span class:list={['absolute left-[13px] top-7 h-[calc(100%-1.1rem)] w-px', index === 0 ? 'bg-white/[.18]' : 'bg-forest-800/[.15]']}></span>}
                  <span class:list={['relative z-10 grid size-7 shrink-0 place-items-center rounded-full text-xs font-black', index === 0 ? 'bg-white text-forest-800' : 'bg-forest-800 text-white']}>{stopIndex + 1}</span>
                  <span class:list={['pt-0.5 text-sm font-black', index === 0 ? 'text-white/[.85]' : 'text-forest-900']}>{stop}</span>
                </li>
              ))}
            </ol>
            <p class:list={['mt-6 border-t pt-5 text-sm leading-7', index === 0 ? 'border-white/[.12] text-white/[.58]' : 'border-forest-800/[.10] text-slate-600']}>{trip.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="section-pad bg-forest-950 text-white">
    <div class="container-page grid gap-12 lg:grid-cols-[.68fr_1.32fr]">
      <div class="reveal lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow text-[#e9b29d]!">常見問題</p>
        <h2 class="section-title text-white!">出發前最常問的問題</h2>
        <p class="section-lead text-white/[.58]!">答案以官方資料和安全原則整理。涉及當日天候、施工、活動與臨時管制時，仍以現場公告為準。</p>
      </div>

      <div class="reveal divide-y divide-white/[.10] rounded-[2rem] border border-white/[.10] bg-white/[.05] px-5 sm:px-7">
        {faqs.map((faq, index) => (
          <details class="group py-2" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 font-black text-white marker:hidden">
              <span>{faq.question}</span>
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-white/[.08] text-white/[.60] transition group-open:rotate-180"><Icon name="chevron" size={17} /></span>
            </summary>
            <p class="max-w-2xl pb-6 pr-8 text-sm leading-8 text-white/[.58]">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad bg-[#e8b8a5]">
    <div class="container-page">
      <div class="reveal relative overflow-hidden rounded-[2.2rem] bg-forest-950 px-6 py-12 text-white shadow-2xl sm:px-10 md:py-16 lg:px-16">
        <div class="absolute -right-12 -top-24 size-72 rounded-full border-[48px] border-white/[.05]"></div>
        <div class="absolute -bottom-32 right-44 size-64 rounded-full bg-cypress-500/[.20] blur-3xl"></div>
        <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <p class="text-xs font-black tracking-[.2em] text-[#e9b29d]">準備出發</p>
            <h2 class="mt-3 max-w-3xl text-3xl font-black tracking-tight sm:text-5xl">帶上野餐墊、飲水與頭盔，開始你的大溪河濱半日</h2>
            <p class="mt-5 max-w-2xl text-sm leading-7 text-white/[.60]">免費入園、全天開放。天候與現場狀況正常時，上午是親子遊玩的穩妥選擇。</p>
          </div>
          <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-14 items-center justify-center gap-2 rounded-full bg-white px-6 text-base font-black text-forest-950 transition hover:-translate-y-1">
            <Icon name="pin" size={20} /> 立即導航
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
