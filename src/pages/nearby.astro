---
export const prerender = true;
import GuideLayout from '../layouts/GuideLayout.astro';
import { nearbyAttractions } from '../data/nearby-attractions';
const faqs = [
  { question: '大溪河濱公園附近最適合順遊哪裡？', answer: '初訪可把大溪橋和大溪老街排在同一趟半日遊；若偏好水岸騎乘，可研究月眉至龍潭三坑水岸觀光綠廊。' },
  { question: '公園和大溪老街適合安排半天嗎？', answer: '可以。建議上午先在公園活動，再依地圖確認交通方式前往大溪橋、老街用餐。每段移動時間以當日導航為準。' },
  { question: '月眉觀光農業區可以徒步走遍嗎？', answer: '月眉屬較廣的區域名稱，不是單一園區入口。先選定具體景點與地圖位置，再安排步行、騎車或開車動線。' },
];
const toc = [{ id: 'places', label: '周邊九處' }, { id: 'halfday', label: '半日行程' }, { id: 'full', label: '一日路線' }, { id: 'tips', label: '行程提醒' }];
---
<GuideLayout topicId="nearby" faqs={faqs} toc={toc}>
  <section id="places" class="section-pad bg-sand-50"><div class="container-page"><p class="eyebrow">附近值得同遊</p><h2 class="section-title">以公園為起點，探索大溪九處人文與水岸景點</h2><p class="section-lead mt-4">每一處都有專屬實景、歷史與文化背景、交通、遊覽路線和獨立地圖搜尋。以下為旅遊規劃參考，不代表所有地點之間都有直接步道。</p><div class="mt-9 grid gap-5 md:grid-cols-2">{nearbyAttractions.map((place, index) => <article class="soft-card overflow-hidden rounded-[1.6rem]"><a href={`/attractions/${place.slug}`}><img src={place.image} alt={`${place.name}實景照片`} loading="lazy" width="1024" height="768" class="aspect-[16/9] w-full object-cover" /></a><div class="p-6"><span class="text-xs font-black tracking-widest text-forest-800">第 {index + 1} 站</span><h3 class="mt-2 text-2xl font-black text-forest-950">{place.name}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{place.intro}</p><div class="mt-5 flex flex-wrap gap-4"><a class="font-black text-forest-800 underline" href={`/attractions/${place.slug}`}>閱讀完整景點專頁</a><a class="font-black text-forest-800 underline" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.mapQuery)}`} target="_blank" rel="noopener noreferrer">專屬地圖</a></div></div></article>)}</div></div></section>
  <section id="halfday" class="section-pad bg-white"><div class="container-page grid gap-8 lg:grid-cols-2 lg:items-center"><div><p class="eyebrow">親子半日遊</p><h2 class="section-title">公園放電，再逛大溪老街</h2><ol class="mt-6 list-decimal space-y-4 pl-6 leading-8 text-slate-700"><li><strong>上午：</strong>大溪河濱公園的遊戲場、草地及休憩區。</li><li><strong>中午前後：</strong>依交通工具移動至大溪橋周邊，確認可行的行人過橋路線。</li><li><strong>午餐與午後：</strong>在大溪老街用餐、看街屋立面，按體力選擇是否延伸至中正公園。</li></ol><p class="mt-4 text-sm text-slate-500">以上為建議順序，非固定交通時刻表。</p></div><img src="/images/shaded-path.webp" alt="大溪河濱公園步道與綠蔭實景" loading="lazy" width="960" height="640" class="w-full rounded-[2rem] object-cover shadow-xl" /></div></section>
  <section id="full" class="section-pad bg-sand-100"><div class="container-page"><p class="eyebrow">戶外一日遊</p><h2 class="section-title">河濱公園、月眉水岸與老街</h2><p class="section-lead mt-4">早上在公園散步或騎車，依交通方式前往月眉一帶選定的水岸節點，下午回到大溪老街。月眉至三坑綠廊較適合有騎乘經驗、能事先確認路線的旅客；帶幼童者可只選一段，不必追求全程。</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn-primary" href="/bike">單車路線與租借資訊</a><a class="btn-primary" href="/directions">交通與入口指南</a></div></div></section>
  <section id="tips" class="section-pad bg-white"><div class="container-page"><p class="eyebrow">路線規劃提醒</p><h2 class="section-title">先決定交通工具，再選景點</h2><div class="mt-7 grid gap-5 md:grid-cols-3">{[
    ['步行旅客', '先確認橋梁、步道與園區出入口，勿以地圖直線距離當作步行距離。'],
    ['自行車旅客', '核對租還車站點、回程路線與河濱路段是否開放。兒童需合適護具。'],
    ['開車旅客', '每處停車點須分別查詢；老街與公園的停車場不是同一個入口。'],
  ].map(([heading, detail]) => <article class="soft-card rounded-3xl p-6"><h3 class="text-xl font-black text-forest-950">{heading}</h3><p class="mt-3 leading-7 text-slate-600">{detail}</p></article>)}</div><p class="mt-8 text-sm text-slate-600">參考：<a class="underline" href="https://travel.tycg.gov.tw/zh-tw/travel/nearby-attractions/598" target="_blank" rel="noopener noreferrer">桃園觀光導覽網周邊景點</a>（2026-11-17 查核）；地點位置及路況出發前請重新核對。</p></div></section>
</GuideLayout>
