---
export const prerender = true;
import InfoLayout from '../layouts/InfoLayout.astro';
import { site, sources } from '../data/site';
---
<InfoLayout title="資料來源與參考資料" lead="本站評分、園區設施、交通、氣象與圖片的資料來源，集中列於此頁，方便旅客交叉查核。">
  {sources.map((source) => (
    <section class="soft-card rounded-3xl p-6 md:p-8">
      <h2>{source.label}</h2>
      <p class="text-slate-700">{source.detail}</p>
      <p class="mt-3"><a href={source.url} target="_blank" rel="noopener noreferrer">{source.linkLabel} ↗</a></p>
    </section>
  ))}
  <section class="soft-card rounded-3xl p-6 md:p-8">
    <h2>資料核對與更新</h2>
    <p>園區與交通資訊可能因維護、天候及活動改變，請以管理單位最新公告與現場情況為準。本站資料更新日期：{site.updatedAt}。</p>
    <p>評分及評論同步時間：{site.ratingSyncedAt}。相關內容另見 <a href="/reviews">評分與評論</a>；圖片來源另見 <a href="/image-credits">圖片版權</a>。</p>
  </section>
</InfoLayout>
