---
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  lead: string;
}
const { title, lead } = Astro.props;
---
<BaseLayout title={`${title}｜${site.fullName}`} description={lead} preloadImage={false} faqs={[]}
  breadcrumbs={[{ name: site.fullName, path: '/' }, { name: title }]}>
  <div class="bg-sand-50 pb-20 pt-28 md:pt-36">
    <div class="container-page">
      <nav class="mb-8 text-sm font-bold text-forest-800" aria-label="麵包屑">
        <a href="/" class="hover:underline">大溪河濱公園</a><span class="mx-2 text-slate-400">/</span>{title}
      </nav>
      <header class="max-w-3xl">
        <h1 class="text-3xl font-black tracking-tight text-forest-950 md:text-5xl">{title}</h1>
        <p class="mt-5 text-base leading-8 text-slate-600">{lead}</p>
      </header>
      <div class="mt-10 grid gap-5 [&_a]:font-bold [&_a]:text-forest-800 [&_a]:underline-offset-4 [&_a:hover]:underline [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-black [&_h2]:text-forest-950 [&_p]:leading-8 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6">
        <slot />
      </div>
      <div class="mt-10"><a href="/" class="btn-primary">返回景點首頁</a></div>
    </div>
  </div>
</BaseLayout>
